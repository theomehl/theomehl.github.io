---
layout: layouts/base.njk
title: Reading Notes
description: Notes and quotes from books I read.
originalDate: 2026-11-16
date: 2026-11-15
eleventyExcludeFromCollections: reading notes
---

<main id="main" class="container flow">
    <h1 id="table-caption">{{title}}</h1>
    <p>{{ description }}</p>
    <div class="commonplace-list-wrapper" id="commonplace-list" class="feature" role="region" aria-labelledby="table-caption" tabindex="0">
        <table class="commonplace-list flow" role="table">
            <thead role="rowgroup">
                <tr role="row">
                    <th role="columnheader">Title</th>
                    <th role="columnheader">Date</th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                {% for post in collections["reading notes"] | reverse %}
                <tr role="row">
                    <td data-column="Title" role="cell">
                        <a href="{{post.url}}">{{post.data.title}}</a>
                        {# <p>{{post.data.description | safe }}</p> #}
                    </td>
                    <td data-column="Date" role="cell">
                        <em><time datetime="{{ post.date | readableDate(" yyyy-LL-dd") }}">{{
                                post.date | readableDate("LLLL dd, yyyy") }}</time></em>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>